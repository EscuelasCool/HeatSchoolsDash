{
  "name": "heatschools-dash",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/stage-base-path.mjs",
    "build:public": "BUILD_PUBLIC=1 next build && BUILD_PUBLIC=1 node scripts/stage-base-path.mjs",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build && wrangler deploy",
    "deploy:public": "npm run build:public && wrangler deploy -c wrangler.public.toml",
    "preview:worker": "npm run build && wrangler dev",
    "preview:public": "npm run build:public && wrangler dev -c wrangler.public.toml"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@observablehq/plot": "^0.6.17",
    "maplibre-gl": "^4.7.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.114.0"
  }
}
